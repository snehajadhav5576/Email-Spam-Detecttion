# Backend environment variables — copy to .env and fill in real values
# DO NOT commit real values to version control

DB_URL=jdbc:mysql://localhost:3306/spamshield?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=spamshield
DB_PASSWORD=CHANGE_ME

# Generate with: openssl rand -hex 64
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_64

# Python ML service — backend only, never exposed to frontend
ML_SERVICE_URL=http://127.0.0.1:8000

# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173
